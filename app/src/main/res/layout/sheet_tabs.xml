<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gf_bg_surface"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp">

    <!-- Authentic 2026 Google Chrome Grid Tab Switcher Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewTab"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+ تب جدید"
            android:textSize="12.5sp"
            app:cornerRadius="19dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewIncognitoTab"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="🕶 ناشناس"
            android:textColor="@color/gf_accent"
            android:textSize="12.5sp"
            app:cornerRadius="19dp"
            app:strokeColor="@color/gf_accent" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterIncognito"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:text="همه تب‌ها"
            android:textColor="@color/gf_text_secondary"
            android:textSize="11.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseAllTabs"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:text="بستن همه"
            android:textColor="@color/gf_danger"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTabsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:text="برای پین کردن، اشتراک‌گذاری یا تکثیر هر تب، روی کارت آن نگه دارید"
        android:textColor="@color/gf_text_secondary"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabs"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp" />

</LinearLayout>
