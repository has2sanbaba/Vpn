<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gf_bg_primary"
    android:orientation="vertical">

    <!-- Top Address & VPN Shield Bar -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/gf_bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <!-- Live VPN Shield Pill -->
        <LinearLayout
            android:id="@+id/btnVpnShield"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_shield_pill_connected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/ivShieldIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/vpn_hub_title"
                app:srcCompat="@drawable/ic_shield_ok" />

            <TextView
                android:id="@+id/tvShieldStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="VPN"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Omnibox -->
        <LinearLayout
            android:id="@+id/omniboxContainer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_omnibox"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/ivSslState"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="SSL"
                app:srcCompat="@drawable/ic_lock" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/omnibox_hint"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:singleLine="true"
                android:textColor="@color/gf_text_primary"
                android:textColorHint="@color/gf_text_secondary"
                android:textDirection="ltr"
                android:textSize="13.5sp" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reload"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Tab Counter -->
        <TextView
            android:id="@+id/btnTabs"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_tab_counter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/gf_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Overflow Menu -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:srcCompat="@drawable/ic_more" />
    </LinearLayout>

    <!-- Page Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/gf_accent"
        android:visibility="gone" />

    <!-- Optional Find-in-Page Bar -->
    <LinearLayout
        android:id="@+id/findInPageBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/gf_bg_elevated"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etFindQuery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="جستجو در صفحه…"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/gf_text_primary"
            android:textColorHint="@color/gf_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnFindNext"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="48dp"
            android:text="بعدی"
            android:textColor="@color/gf_accent"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnFindClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Find"
            app:srcCompat="@drawable/ic_close" />
    </LinearLayout>

    <!-- Main Browser Viewport + Start Dashboard -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Start / Home Dashboard -->
        <ScrollView
            android:id="@+id/homeDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gf_bg_primary"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- GreatFire VPN Live Hero Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivHeroShield"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="Shield"
                            app:srcCompat="@drawable/ic_shield_ok"
                            app:tint="@color/gf_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHeroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="تونل ضد فیلتر GreatFire فعال است"
                                android:textColor="@color/gf_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHeroProfile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="موتور هوشمند: Envoy + IEnvoyProxy + FreeBrowser DoH"
                                android:textColor="@color/gf_accent"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroMetrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="↓ 0 KB   ↑ 0 KB   •   DoH: فعال   •   Kill-Switch: روشن"
                        android:textColor="@color/gf_text_secondary"
                        android:textDirection="ltr"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHeroToggleVpn"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/btn_disconnect"
                            android:textSize="12.5sp"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHeroOpenHub"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="سرورها و پروتکل‌ها"
                            android:textColor="@color/gf_accent"
                            android:textSize="12.5sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/gf_accent" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeroProbe"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="⚡ تست سلامت و پینگ تونل ضد فیلتر"
                        android:textColor="@color/gf_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Quick Access Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="دسترسی سریع بدون فیلتر"
                    android:textColor="@color/gf_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/quickLinksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Architecture Info Footer -->
                <TextView
                    android:id="@+id/tvDeviceCompatInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Powered by GreatFire Envoy • Chromium Cronet • IEnvoyProxy • FreeBrowser"
                    android:textColor="@color/gf_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Ergonomic Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/gf_bg_surface"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:srcCompat="@drawable/ic_arrow_back" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            app:srcCompat="@drawable/ic_arrow_forward" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            app:srcCompat="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnPanicWipe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Panic Wipe"
            app:srcCompat="@drawable/ic_wipe" />

        <ImageButton
            android:id="@+id/btnBottomVpn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="VPN Settings"
            app:srcCompat="@drawable/ic_shield_ok"
            app:tint="@color/gf_accent" />
    </LinearLayout>

</LinearLayout>
