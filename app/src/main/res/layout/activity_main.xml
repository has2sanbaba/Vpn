<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gf_bg_primary">

    <LinearLayout
        android:id="@+id/browserChromeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Authentic Google Chrome Android 56dp Top Toolbar -->
        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/gf_bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_home" />

            <!-- Authentic Chrome Pill Omnibox -->
            <LinearLayout
                android:id="@+id/omniboxContainer"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/ivSslState"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Site Security Info"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/omnibox_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/gf_text_primary"
                    android:textColorHint="@color/gf_text_secondary"
                    android:textSize="14.5sp" />

                <ImageButton
                    android:id="@+id/btnClearUrl"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear"
                    android:padding="5dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_close" />

                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voice Search"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/btnReload"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reload"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_refresh" />
            </LinearLayout>

            <!-- Chrome Square Tab Switcher Counter (Tap = Grid Tabs, Long-Press = Quick Menu) -->
            <TextView
                android:id="@+id/btnTabs"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_tab_counter"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/gf_text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Chrome 3-Dot Overflow Menu -->
            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                app:srcCompat="@drawable/ic_more" />
        </LinearLayout>

        <!-- Chrome Hairline Bottom Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gf_border" />

        <!-- Thin Chrome Linear Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/gf_accent"
            android:visibility="gone" />

        <!-- Authentic Chrome Find-in-Page Bar (with Match Counter + Prev/Next + Close) -->
        <LinearLayout
            android:id="@+id/findInPageBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/gf_card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etFindQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="جستجو در صفحه…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/gf_text_primary"
                android:textColorHint="@color/gf_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFindCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="0/0"
                android:textColor="@color/gf_text_secondary"
                android:textSize="12.5sp" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous Match"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_chevron_up" />

            <ImageButton
                android:id="@+id/btnFindNext"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next Match"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_chevron_down" />

            <ImageButton
                android:id="@+id/btnFindClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Find"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_close" />
        </LinearLayout>

        <!-- Main Browser Viewport + Chrome New Tab Page + Live Autocomplete Overlay -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.greatfire.browser.web.BrowserSwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/webViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </org.greatfire.browser.web.BrowserSwipeRefreshLayout>

            <!-- Authentic Google Chrome New Tab Page -->
            <ScrollView
                android:id="@+id/homeDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gf_bg_primary"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="44dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <!-- Authentic Google / Chrome Wordmark -->
                    <TextView
                        android:id="@+id/tvBrandLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.02"
                        android:text="Google"
                        android:textColor="@color/gf_text_primary"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <!-- Centered Chrome Search Pill with Voice Search -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_omnibox"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Search"
                            app:srcCompat="@drawable/ic_search" />

                        <EditText
                            android:id="@+id/etHomeSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/home_search_hint"
                            android:imeOptions="actionSearch|flagNoExtractUi"
                            android:importantForAutofill="no"
                            android:inputType="textUri|textNoSuggestions"
                            android:singleLine="true"
                            android:textColor="@color/gf_text_primary"
                            android:textColorHint="@color/gf_text_secondary"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/btnHomeVoice"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Voice Search"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_mic" />
                    </LinearLayout>

                    <!-- Customizable Chrome Circular Shortcuts Grid -->
                    <LinearLayout
                        android:id="@+id/quickLinksContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="vertical" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Clean Smart Proxy Pill (1-tap switch to fastest server or open settings) -->
                    <LinearLayout
                        android:id="@+id/proxyQuickBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_card_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="9dp">

                        <TextView
                            android:id="@+id/tvSubtleStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="● درحال انتخاب سریع‌ترین پروکسی…"
                            android:textColor="@color/gf_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnQuickSwitchProxy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="⚡ سریع‌ترین پروکسی"
                            android:textColor="@color/gf_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Chrome Omnibox Live Autocomplete & History/Bookmark Suggestions Dropdown -->
            <LinearLayout
                android:id="@+id/omniboxSuggestionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chrome_menu"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Fullscreen HTML5 Video Container (YouTube, etc.) -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
