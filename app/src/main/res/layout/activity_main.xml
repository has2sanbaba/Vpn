<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gf_bg_primary">

    <LinearLayout
        android:id="@+id/browserChromeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Authentic 2026 Google Chrome Android 56dp Toolbar (Movable Top / Bottom) -->
        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/gf_bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:padding="7dp"
                app:srcCompat="@drawable/ic_home" />

            <!-- Authentic Google Chrome Material 3 Stadium Omnibox -->
            <LinearLayout
                android:id="@+id/omniboxContainer"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="5dp">

                <ImageButton
                    android:id="@+id/ivSslState"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Site Controls"
                    android:padding="4dp"
                    app:srcCompat="@drawable/ic_google_g" />

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:ellipsize="end"
                    android:gravity="center_vertical|start"
                    android:hint="@string/omnibox_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/gf_text_primary"
                    android:textColorHint="@color/gf_text_secondary"
                    android:textSize="14.5sp" />

                <!-- IDM Detected Video Quick Action Badge inside Chrome Omnibox -->
                <TextView
                    android:id="@+id/btnIdmOmnibox"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_idm_floating_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="🎬 ۱"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnClearUrl"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:padding="5dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_close" />

                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voice Search"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/btnReload"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reload or Go"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_refresh" />
            </LinearLayout>

            <!-- Chrome Quick '+' New Tab Button -->
            <ImageButton
                android:id="@+id/btnNewTabQuick"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="New Tab"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_add" />

            <!-- Chrome Square Tab Switcher Counter -->
            <TextView
                android:id="@+id/btnTabs"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_tab_counter"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/gf_text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Chrome 3-Dot Overflow Menu -->
            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                app:srcCompat="@drawable/ic_more" />
        </LinearLayout>

        <!-- Chrome Hairline Divider -->
        <View
            android:id="@+id/toolbarDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gf_border" />

        <!-- Thin Chrome Linear Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/gf_accent"
            android:visibility="gone" />

        <!-- Authentic Chrome Find-in-Page Bar -->
        <LinearLayout
            android:id="@+id/findInPageBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/gf_card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etFindQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="جستجو در صفحه…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/gf_text_primary"
                android:textColorHint="@color/gf_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFindCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="0/0"
                android:textColor="@color/gf_text_secondary"
                android:textSize="12.5sp" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous Match"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_chevron_up" />

            <ImageButton
                android:id="@+id/btnFindNext"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next Match"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_chevron_down" />

            <ImageButton
                android:id="@+id/btnFindClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Find"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_close" />
        </LinearLayout>

        <!-- Authentic Chrome 'Listen to this page' TTS Mini-Player Bar -->
        <LinearLayout
            android:id="@+id/ttsListenBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/gf_card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Listen"
                app:srcCompat="@drawable/ic_volume_up" />

            <TextView
                android:id="@+id/tvTtsStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="درحال خواندن صوتی صفحه…"
                android:textColor="@color/gf_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTtsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="⏸ توقف"
                android:textColor="@color/gf_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnTtsClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Stop TTS"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_close" />
        </LinearLayout>

        <!-- Main Browser Viewport + Authentic 2026 Chrome New Tab Page + IDM Floating Pill -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.greatfire.browser.web.BrowserSwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/webViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </org.greatfire.browser.web.BrowserSwipeRefreshLayout>

            <!-- Authentic 2026 Google Chrome Android New Tab Page -->
            <ScrollView
                android:id="@+id/homeDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gf_bg_primary"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="32dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:id="@+id/tvBrandLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.02"
                        android:text="Google"
                        android:textColor="@color/gf_text_primary"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <!-- Authentic 2026 Chrome NTP Search Pill (4-Color G + Hint + Mic + Google Lens) -->
                    <LinearLayout
                        android:id="@+id/homeSearchBox"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_omnibox"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Google"
                            app:srcCompat="@drawable/ic_google_g" />

                        <TextView
                            android:id="@+id/tvHomeSearchHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/home_search_hint"
                            android:textColor="@color/gf_text_secondary"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/btnHomeVoice"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Voice Search"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_mic" />

                        <ImageButton
                            android:id="@+id/btnHomeLens"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Google Lens"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_lens" />
                    </LinearLayout>

                    <!-- Authentic 2026 Chrome NTP Action Pills Row (Incognito | IDM Video Grabber | Customize) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/chipNtpIdmGrabber"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ntp_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="IDM"
                                app:srcCompat="@drawable/ic_video_grab" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="دانلودر ویدیو IDM"
                                android:textColor="@color/gf_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chipNtpIncognito"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ntp_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Incognito"
                                app:srcCompat="@drawable/ic_incognito" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="تب ناشناس"
                                android:textColor="@color/gf_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/chipNtpCustomize"
                            android:layout_width="38dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_ntp_chip"
                            android:contentDescription="Chrome Appearance"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_palette" />
                    </LinearLayout>

                    <!-- Authentic 2026 Chrome Tonal Shortcuts Card Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_ntp_shortcuts_card"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp">

                        <LinearLayout
                            android:id="@+id/quickLinksContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Multi-Source Smart Anti-Censorship Card -->
                    <LinearLayout
                        android:id="@+id/proxyQuickBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_card_dark"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tvSubtleStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="● درحال جستجو از ۱۰ منبع پروکسی…"
                            android:textColor="@color/gf_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnQuickSwitchProxy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="⚡ سریع‌ترین پروکسی"
                            android:textColor="@color/gf_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- IDM-Style Floating "Download This Video" Pill (Auto-appears when page has video/stream!) -->
            <LinearLayout
                android:id="@+id/idmFloatingPill"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_idm_floating_pill"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvIdmFloatingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingEnd="8dp"
                    android:text="🎬 دانلود این ویدیو (۱)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDismissIdmPill"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#E8EAED"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Scrollable Chrome Omnibox Dropdown (Page Copy/Share/Edit + Clipboard Paste & Go + Live Suggest) -->
            <ScrollView
                android:id="@+id/omniboxSuggestionsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chrome_menu"
                android:elevation="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/omniboxSuggestionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Fullscreen HTML5 Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
