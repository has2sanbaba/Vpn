<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gf_bg_surface"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="افزودن کانفیگ VPN / Envoy / لینک اشتراک"
        android:textColor="@color/gf_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="پشتیبانی از تمام پروتکل‌های GreatFire:\nvmess:// • vless:// (xhttp) • v2ws:// • v2srtp:// • v2wechat:// • ss:// • hy2:// • hysteria2:// • envoy:// • masque:// • snowflake:// • obfs4:// • meek:// • socks5:// • http:// و لینک‌های اشتراک (Subscription https://)"
        android:textColor="@color/gf_text_secondary"
        android:textSize="11.5sp" />

    <EditText
        android:id="@+id/etProfileName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_omnibox"
        android:hint="نام دلخواه (اختیاری)"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/gf_text_primary"
        android:textColorHint="@color/gf_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etConfigUri"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_omnibox"
        android:gravity="top|start"
        android:hint="لینک کانفیگ یا لینک اشتراک را اینجا جای‌گذاری کنید…"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/gf_text_primary"
        android:textColorHint="@color/gf_text_secondary"
        android:textDirection="ltr"
        android:textSize="12.5sp" />

</LinearLayout>
